# Makefile para compilar Transformer en WSL/Linux
# Soporta tanto CPU como GPU (CUDA)

# Detectar si CUDA está disponible
CUDA_PATH ?= /usr/local/cuda
HAS_CUDA := $(shell which nvcc 2>/dev/null)

# Compiladores
CXX = g++
NVCC = nvcc

# Directorios
SRCDIR = src
INCDIR = include
OBJDIR = obj_wsl
BINDIR = bin

# Crear directorios si no existen
$(shell mkdir -p $(OBJDIR) $(BINDIR))

# Flags base
CXXFLAGS = -std=c++17 -O3 -march=native -fopenmp -Wall -Wextra
NVCCFLAGS = -std=c++17 -O3 -arch=sm_86
INCLUDES = -I$(INCDIR)
LDFLAGS = 
LIBS = -lm -lpthread

# Si CUDA está disponible
ifdef HAS_CUDA
    CXXFLAGS += -DUSE_CUDA
    NVCCFLAGS += -DUSE_CUDA
    INCLUDES += -I$(CUDA_PATH)/include
    LDFLAGS += -L$(CUDA_PATH)/lib64
    LIBS += -lcudart -lcublas -lcublasLt -lcurand
    CUDA_OBJS = $(OBJDIR)/matrix_cuda.o
else
    CUDA_OBJS =
endif

# Archivos fuente
SOURCES = $(SRCDIR)/matrix.cpp \
          $(SRCDIR)/mnist_loader.cpp \
          $(SRCDIR)/transformer.cpp

# Archivos objeto
OBJECTS = $(OBJDIR)/matrix.o \
          $(OBJDIR)/mnist_loader.o \
          $(OBJDIR)/transformer.o \
          $(CUDA_OBJS)

# Diferentes versiones de main
MAINS = main.cpp \
        main_speed_max.cpp \
        main_speed_balanced.cpp \
        main_ultra_light.cpp \
        main_high_initial_acc.cpp

# Ejecutables correspondientes
TARGETS = $(BINDIR)/transformer \
          $(BINDIR)/transformer_speed_max \
          $(BINDIR)/transformer_balanced \
          $(BINDIR)/transformer_ultra_light \
          $(BINDIR)/transformer_high_acc

# Colores para output
RED = \033[0;31m
GREEN = \033[0;32m
YELLOW = \033[1;33m
BLUE = \033[0;34m
NC = \033[0m

# Regla por defecto
all: info $(TARGETS)
	@echo "$(GREEN)✅ Compilación completada$(NC)"
	@echo "$(BLUE)Ejecutables en $(BINDIR)/$(NC)"

# Mostrar información
info:
	@echo "$(BLUE)===============================================$(NC)"
	@echo "$(BLUE) COMPILANDO TRANSFORMER PARA WSL/LINUX$(NC)"
	@echo "$(BLUE)===============================================$(NC)"
ifdef HAS_CUDA
	@echo "$(GREEN)✅ CUDA detectado - Compilando con GPU$(NC)"
else
	@echo "$(YELLOW)⚠️  CUDA no detectado - Compilando solo CPU$(NC)"
endif
	@echo

# Regla para ejecutable estándar
$(BINDIR)/transformer: $(OBJDIR)/main.o $(OBJECTS)
	@echo "$(BLUE)🔗 Enlazando $@...$(NC)"
	@$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "$(GREEN)✅ $@ creado$(NC)"

# Regla para Speed Max
$(BINDIR)/transformer_speed_max: $(OBJDIR)/main_speed_max.o $(OBJECTS)
	@echo "$(BLUE)🔗 Enlazando $@...$(NC)"
	@$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "$(GREEN)✅ $@ creado$(NC)"

# Regla para Balanced
$(BINDIR)/transformer_balanced: $(OBJDIR)/main_speed_balanced.o $(OBJECTS)
	@echo "$(BLUE)🔗 Enlazando $@...$(NC)"
	@$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "$(GREEN)✅ $@ creado$(NC)"

# Regla para Ultra Light
$(BINDIR)/transformer_ultra_light: $(OBJDIR)/main_ultra_light.o $(OBJECTS)
	@echo "$(BLUE)🔗 Enlazando $@...$(NC)"
	@$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "$(GREEN)✅ $@ creado$(NC)"

# Regla para High Accuracy
$(BINDIR)/transformer_high_acc: $(OBJDIR)/main_high_initial_acc.o $(OBJECTS)
	@echo "$(BLUE)🔗 Enlazando $@...$(NC)"
	@$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS) $(LIBS)
	@echo "$(GREEN)✅ $@ creado$(NC)"

# Reglas para compilar archivos objeto C++
$(OBJDIR)/%.o: $(SRCDIR)/%.cpp
	@echo "$(BLUE)🔨 Compilando $<...$(NC)"
	@$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
	@echo "$(GREEN)✅ $@ compilado$(NC)"

# Reglas para compilar mains
$(OBJDIR)/%.o: %.cpp
	@echo "$(BLUE)🔨 Compilando $<...$(NC)"
	@$(CXX) $(CXXFLAGS) $(INCLUDES) -c $< -o $@
	@echo "$(GREEN)✅ $@ compilado$(NC)"

# Regla para compilar CUDA
ifdef HAS_CUDA
$(OBJDIR)/matrix_cuda.o: $(SRCDIR)/matrix_cuda.cu
	@echo "$(YELLOW)🚀 Compilando kernel CUDA $<...$(NC)"
	@$(NVCC) $(NVCCFLAGS) $(INCLUDES) -c $< -o $@
	@echo "$(GREEN)✅ $@ compilado$(NC)"
endif

# Limpiar archivos compilados
clean:
	@echo "$(YELLOW)🧹 Limpiando...$(NC)"
	@rm -rf $(OBJDIR) $(BINDIR)
	@echo "$(GREEN)✅ Limpieza completada$(NC)"

# Ejecutar versión balanceada por defecto
run: $(BINDIR)/transformer_balanced
	@echo "$(BLUE)🚀 Ejecutando versión balanceada...$(NC)"
	@echo "================================"
	@./$(BINDIR)/transformer_balanced

# Ejecutar con monitoreo de GPU
run-gpu: $(BINDIR)/transformer_balanced
ifdef HAS_CUDA
	@echo "$(BLUE)🚀 Ejecutando con monitoreo GPU...$(NC)"
	@echo "================================"
	@nvidia-smi dmon -i 0 -s mu -d 1 & \
	PID=$$!; \
	./$(BINDIR)/transformer_balanced; \
	kill $$PID 2>/dev/null
else
	@echo "$(RED)❌ CUDA no disponible$(NC)"
endif

# Descargar dataset si no existe
dataset:
	@echo "$(BLUE)📥 Verificando dataset...$(NC)"
	@if [ ! -f "train-images-idx3-ubyte" ]; then \
		echo "$(YELLOW)Descargando dataset Fashion-MNIST...$(NC)"; \
		wget -q --show-progress http://fashion-mnist.s3-website.eu-central-1.amazonaws.com/train-images-idx3-ubyte.gz; \
		wget -q --show-progress http://fashion-mnist.s3-website.eu-central-1.amazonaws.com/train-labels-idx1-ubyte.gz; \
		wget -q --show-progress http://fashion-mnist.s3-website.eu-central-1.amazonaws.com/t10k-images-idx3-ubyte.gz; \
		wget -q --show-progress http://fashion-mnist.s3-website.eu-central-1.amazonaws.com/t10k-labels-idx1-ubyte.gz; \
		echo "$(YELLOW)Descomprimiendo...$(NC)"; \
		gunzip -f *.gz; \
		echo "$(GREEN)✅ Dataset descargado$(NC)"; \
	else \
		echo "$(GREEN)✅ Dataset ya existe$(NC)"; \
	fi

# Ayuda
help:
	@echo "$(BLUE)Comandos disponibles:$(NC)"
	@echo "  make all      - Compilar todas las versiones"
	@echo "  make clean    - Limpiar archivos compilados"
	@echo "  make run      - Ejecutar versión balanceada"
	@echo "  make run-gpu  - Ejecutar con monitoreo GPU"
	@echo "  make dataset  - Descargar dataset Fashion-MNIST"
	@echo "  make help     - Mostrar esta ayuda"
	@echo
	@echo "$(BLUE)Versiones disponibles:$(NC)"
	@echo "  transformer           - Versión estándar"
	@echo "  transformer_speed_max - Velocidad máxima (<500ms)"
	@echo "  transformer_balanced  - Balanceado (75-80% acc)"
	@echo "  transformer_ultra_light - Ultra ligero (<400K params)"
	@echo "  transformer_high_acc  - High initial accuracy"

# Benchmarks
benchmark: all
	@echo "$(BLUE)📊 Ejecutando benchmarks...$(NC)"
	@echo "================================"
	@for exe in $(TARGETS); do \
		echo "$(YELLOW)Testing $$exe...$(NC)"; \
		timeout 60s $$exe | grep -E "(Tiempo|Accuracy|GPU)" || true; \
		echo; \
	done

.PHONY: all clean run run-gpu dataset help info benchmark